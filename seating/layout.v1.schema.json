{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://halom.io/mana/seating/layout.v1.schema.json",
  "title": "layout.v1 — a venue's room for the seat map (metres; validate.mjs is the executable truth)",
  "type": "object",
  "required": ["v", "venue", "room", "walls", "zones", "tables"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "venue": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "note": { "type": "string", "maxLength": 300 },
    "room": { "type": "object", "required": ["w", "d"], "additionalProperties": false, "properties": { "w": { "type": "number", "minimum": 1, "maximum": 200 }, "d": { "type": "number", "minimum": 1, "maximum": 200 } } },
    "walls": { "type": "array", "items": { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": {
      "from": { "$ref": "#/definitions/point" }, "to": { "$ref": "#/definitions/point" },
      "kind": { "enum": ["wall", "window", "door"], "default": "wall" },
      "gap": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2, "description": "a door: where along the wall it opens, [start, end] in metres from `from`" } } } },
    "zones": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "rect"], "additionalProperties": false, "properties": {
      "id": { "$ref": "#/definitions/id" }, "name": { "$ref": "#/definitions/text" },
      "rect": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 4, "maxItems": 4, "description": "[x1, z1, x2, z2] inside the room" } } } },
    "tables": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "zone", "x", "z", "shape", "seats", "minParty", "maxParty", "bookable"], "additionalProperties": false, "properties": {
      "id": { "$ref": "#/definitions/id" }, "zone": { "$ref": "#/definitions/id" }, "name": { "type": "string", "maxLength": 40 },
      "x": { "type": "number" }, "z": { "type": "number" }, "rot": { "type": "number", "minimum": -360, "maximum": 360, "default": 0 },
      "shape": { "enum": ["round", "square", "long", "bar"] },
      "seats": { "type": "integer", "minimum": 1, "maximum": 40 }, "minParty": { "type": "integer", "minimum": 1, "maximum": 40 }, "maxParty": { "type": "integer", "minimum": 1, "maximum": 40, "description": "minParty <= maxParty <= seats" },
      "bookable": { "type": "boolean", "description": "false draws a table nobody books (the bar counter)" } } } },
    "tableChoice": { "type": "boolean", "default": true, "description": "the owner's switch: false lets guests pick an area only" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "text": { "type": "object", "required": ["he", "en"], "properties": { "he": { "type": "string", "maxLength": 80 }, "en": { "type": "string", "maxLength": 80 } } }
  }
}
