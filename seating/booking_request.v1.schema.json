{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://halom.io/mana/seating/booking_request.v1.schema.json",
  "title": "booking_request.v1 — a guest asks for an area or a table; the owner approves, swaps the table or declines with a reason (validate.mjs is the executable truth; name and phone are personal data)",
  "type": "object",
  "required": ["v", "id", "venue", "zone", "table", "date", "time", "party", "name", "phone", "status"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
    "venue": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "zone": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
    "table": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$", "description": "a table in the zone that fits the party, or null: any table in this area" },
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "party": { "type": "integer", "minimum": 1, "maximum": 40 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "phone": { "type": "string", "pattern": "^\\+?[0-9][0-9 \\-]{4,19}$" },
    "note": { "type": "string", "maxLength": 300 },
    "status": { "enum": ["pending", "approved", "declined"] },
    "reason": { "type": "string", "maxLength": 200, "description": "required when declined, empty otherwise; the guest reads it" },
    "createdAt": { "type": "string", "format": "date-time" },
    "decidedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "x-transitions": {
    "pending": { "approve": "approved (optionally at another fitting table, or table null = the area only)", "decline": "declined (reason required)" },
    "approved": { "swap": "approved at another fitting table" },
    "declined": {}
  }
}
