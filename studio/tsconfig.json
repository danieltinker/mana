{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": false, "noImplicitAny": false, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "isolatedModules": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
