{
  "name": "mana-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mana (Halom's menu product): staff back office. Sources in src/ (v1) and src/v2/ (schema 2, ADR-007), built static output in dist/.",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc -p tsconfig.json",
    "serve": "node test/stub.mjs",
    "serve:v2": "node test/v2/stub.mjs",
    "test:unit": "node --test test/unit.test.mjs test/v2/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs test/v2/browser.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:sql": "node test/real-sql.mjs --proposal"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@mana/contracts": "0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.0",
    "preact": "^10.29.8",
    "typescript": "^7.0.2"
  }
}
