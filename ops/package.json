{
  "name": "mana-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mana (Halom's 3D-menu product): staff back office. Sources in src/, built static output in dist/.",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node test/stub.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:sql": "node test/real-sql.mjs --proposal"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.0",
    "preact": "^10.29.8"
  }
}
